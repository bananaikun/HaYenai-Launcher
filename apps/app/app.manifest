<?xml version="1.0" encoding="utf-8"?>
<!--
  启动器必须以管理员身份运行（主人 2026-11-15 拍板）。
  原因：内存优化的系统级清理走 NtSetSystemInformation + SeProfileSingleProcessPrivilege，
  非管理员会直接失败；另外实例启动/整合包解压也常有权限相关的边角问题。
  代价是每次启动都会弹一次 UAC。
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <dependency>
    <groupId>Microsoft.Windows.Common-Controls</groupId>
    <artifactId>Microsoft.Windows.Common-Controls</artifactId>
    <version>6.0.0.0</version>
    <processorArchitecture="*"/>
    <publicKeyToken>6595b64144ccf1df</publicKeyToken>
    <language>*</language>
  </dependency>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
