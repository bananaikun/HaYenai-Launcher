+
+float Schlick_GGX(float NV, float roughness) {
+    float roughnessBase = roughness + 1.0;
+    float roughnessScaled = (roughnessBase * roughnessBase) / 8.0;
+    return NV / (NV * (1.0 - roughnessScaled) + roughnessScaled);
